<?xml version="1.0" encoding="UTF-8"?>
<!--
  Rossonero - Connect IQ watch face manifest

  Store-submittable: this build is deliberately just the red/black color
  scheme (Italian "rossonero" = "red-black", a generic color name, not the
  club's crest or wordmark). See README.md for the reasoning and how this
  differs from the milan-personal project.

  NOTE ON DEVICE IDS: same caveat as Ritmo's manifest - refresh this list
  via "Monkey C: Edit Products" before your first build.
-->
<iq:manifest version="3" xmlns:iq="http://www.garmin.com/xml/connectiq">
  <iq:application
    id="1ddb190f-7f3e-4d09-a35e-66f8563479f7"
    type="watchface"
    name="@Strings.AppName"
    entry="RossoneroApp"
    launcherIcon="@Drawables.LauncherIcon"
    minApiLevel="4.0.0">
    <!-- Bumped from 3.3.0: the top-of-face soccer ball is now a bitmap
         resource drawn with Dc.drawScaledBitmap (API 4.0.0), replacing
         the hand-drawn vector version - see README.md. Every device in
         the product list below is already CIQ4+, so this doesn't drop
         support for any of them. -->

    <iq:products>
      <iq:product id="venu2"/>
      <iq:product id="venu2s"/>
      <iq:product id="vivoactive4"/>
      <iq:product id="vivoactive5"/>
      <iq:product id="fenix7"/>
      <iq:product id="fenix7s"/>
      <iq:product id="fenix7x"/>
      <iq:product id="epix2"/>
      <iq:product id="fr265"/>
      <iq:product id="fr265s"/>
      <iq:product id="fr965"/>
    </iq:products>

    <!-- Permission history: "Weather" was tried first and rejected by a
         real compiler run ("Invalid permission provided: Weather") -
         confirmed against Garmin's Toybox.Weather/CurrentConditions docs
         that no permission at all is needed for .temperature specifically,
         so the block was removed entirely rather than swapped to a
         different id.

         Positioning ADDED BACK in the "second hand / move bar /
         sunrise-sunset / step ring" round: the new Sunrise/Sunset fields
         call Weather.getSunrise()/getSunset(), which need a
         Position.Location - both places RossoneroView.mc's sunLocation()
         can get one from (Activity.Info.currentLocation,
         Weather.CurrentConditions.observationLocationPosition) are
         themselves gated behind this exact permission per their own API
         docs. This is a real, user-visible change from every previous
         round of this project: it's the first permission this
         Store-submittable app has ever requested, worth being aware of if
         you do submit it - Garmin Store review and the install prompt
         both surface requested permissions. No other new permission is
         needed for anything else in this round (move bar and the step
         ring are both ActivityMonitor.Info, already unrestricted). -->
    <iq:permissions>
      <iq:uses-permission id="Positioning"/>
    </iq:permissions>

    <iq:languages>
      <iq:language>eng</iq:language>
    </iq:languages>

    <iq:barrels/>
  </iq:application>
</iq:manifest>
