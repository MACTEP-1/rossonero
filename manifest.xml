<?xml version="1.0" encoding="UTF-8"?>
<!--
  Rossonero - Connect IQ watch face manifest

  Store-submittable: this build is deliberately just the red/black color
  scheme (Italian "rossonero" = "red-black", a generic color name, not the
  club's crest or wordmark). See README.md for the reasoning and how this
  differs from the milan-personal project.

  NOTE ON DEVICE IDS: same caveat as Ritmo's manifest - refresh this list
  via "Monkey C: Edit Products" before your first build.
-->
<iq:manifest version="3" xmlns:iq="http://www.garmin.com/xml/connectiq">
  <iq:application
    id="1ddb190f-7f3e-4d09-a35e-66f8563479f7"
    type="watchface"
    name="@Strings.AppName"
    entry="RossoneroApp"
    launcherIcon="@Drawables.LauncherIcon"
    minApiLevel="4.0.0">
    <!-- Bumped from 3.3.0: the top-of-face soccer ball is now a bitmap
         resource drawn with Dc.drawScaledBitmap (API 4.0.0), replacing
         the hand-drawn vector version - see README.md. Every device in
         the product list below is already CIQ4+, so this doesn't drop
         support for any of them. -->

    <iq:products>
      <iq:product id="venu2"/>
      <iq:product id="venu2s"/>
      <iq:product id="vivoactive4"/>
      <iq:product id="vivoactive5"/>
      <iq:product id="fenix7"/>
      <iq:product id="fenix7s"/>
      <iq:product id="fenix7x"/>
      <iq:product id="epix2"/>
      <iq:product id="fr265"/>
      <iq:product id="fr265s"/>
      <iq:product id="fr965"/>
    </iq:products>

    <!-- CORRECTED after a real compiler error: "Weather" is NOT a valid
         permission id - monkeybrains rejected it outright ("Invalid
         permission provided: Weather"). Turns out no permission is needed
         at all for Weather.getCurrentConditions() - confirmed against
         Garmin's Toybox.Weather/CurrentConditions API docs: the only
         fields gated behind a permission are observationLocationPosition
         and observationLocationName, which need "Positioning", and
         temperatureText() (see RossoneroView.mc) only reads .temperature,
         which isn't one of those. So the permissions block is removed
         entirely rather than swapped to a different id. No other
         permission is needed: no auto theme, no SensorHistory field, no
         other networking. -->

    <iq:languages>
      <iq:language>eng</iq:language>
    </iq:languages>

    <iq:barrels/>
  </iq:application>
</iq:manifest>
