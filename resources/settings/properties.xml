<properties>
    <property id="ShowSeconds" type="boolean">false</property>

    <!-- Which stat each of the 3 badge circles shows. Values match
         RossoneroView.mc's FIELD_* constants exactly:
         0=Steps 1=Heart Rate 2=Calories 3=Distance 4=Floors Climbed
         5=Active Minutes 6=Battery 7=Stress 8=Temperature 9=World Clock
         10=Move Bar 11=Sunrise 12=Sunset.
         Defaults (0/1/2) reproduce the original fixed steps/heart/calories
         layout, so an existing install looks unchanged until the user
         actually opens Settings. -->
    <property id="Field1" type="number">0</property>
    <property id="Field2" type="number">1</property>
    <property id="Field3" type="number">2</property>

    <!-- Long-press "alternate" field set - what the 3 circles switch to
         on a touch-and-hold (see RossoneroView.mc's toggleAltFields()).
         Defaults deliberately differ from Field1/2/3 above so the
         long-press is immediately noticeable: 4=Floors Climbed 7=Stress
         10=Move Bar (must match shared-src/SettingsMenu.mc's
         ALT_FIELD*_DEFAULT constants). -->
    <property id="Field1Alt" type="number">4</property>
    <property id="Field2Alt" type="number">7</property>
    <property id="Field3Alt" type="number">10</property>

    <!-- Whole-hour UTC offset for the World Clock field. Only matters if a
         circle is actually set to World Clock. -->
    <property id="WorldClockOffset" type="number">0</property>

    <!-- 0=Digital (the original hour:minute readout), 1=Analog (hour/
         minute hands from screen center). Default 0 keeps existing
         installs unchanged until the user opens Settings. -->
    <property id="ClockStyle" type="number">0</property>

    <!-- Digital-only decorative steps/stepGoal progress ring - see
         RossoneroView.mc's STEP_RING_* constants for why this doesn't show
         in Analog. Default true (on); off entirely skips the calculation
         if the user doesn't want it. -->
    <property id="ShowStepRing" type="boolean">true</property>
</properties>
