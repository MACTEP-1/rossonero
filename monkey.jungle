# Rossonero Connect IQ project build file
project.manifest = manifest.xml
base.resourcePath = resources

# Pulls in shared/SettingsMenu.mc from the sibling garmin-shared-src folder
# (same folder milan-personal and santorini-sunset point at) alongside
# this project's own source/ - see garmin-shared-src/SettingsMenu.mc's header
# comment for why this exists. "source" here is the SDK's usual default,
# spelled out explicitly because setting base.sourcePath at all
# overrides that default rather than adding to it.
base.sourcePath = source;../garmin-shared-src
